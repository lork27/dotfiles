
(defcfg
  process-unmapped-keys (all-except
    f13 f14 f15 f16 f17 f18 f19 f20
    brdn brup bldn blup
    mute vold volu prev pp next
  )
)

(defsrc
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  fn
  caps
  spc
  h f j k l
  u i
)

(defalias
  escctrl (tap-hold 100 100 esc lctl)
  navhold (tap-hold 200 200 spc (layer-toggle nav))
  fnhold (multi fn (layer-while-held fnrow))
  fshft (tap-hold-release 1 200 f lsft)
  jshft (tap-hold-release 1 200 j rsft)
)

(deflayer base
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  @fnhold
  @escctrl
  @navhold
  h @fshft @jshft k l
  u i
)

(deflayer nav
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _
  _
  left _ down up right
  pgdn pgup
)

(deflayer fnrow
  brdn brup mctl sls dtn dnd prev pp next mute vold volu
  _
  _
  _
  _ _ _ _ _
  _ _
)
