// Zed settings for Windows. Windows Zed rewrites settings.json itself, so this
// file is copied (not symlinked) into %APPDATA%\Zed\settings.json by
// windows\apply.ps1. The Yorha / Yorha Dark palettes come from themes\zed\yorha.json.
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Yorha",
    "dark": "Yorha Dark"
  }
}
