# aesthetics
background-opacity = 1
background-blur-radius = 100
theme = light:yorha,dark:yorha-dark
macos-titlebar-style = hidden
# Nudge any text below 3:1 against its own background (apps sometimes pair ANSI
# colors the yorha palettes weren't tuned for, e.g. black-on-blue tab labels).
minimum-contrast = 3

# typography
font-size = 14
font-thicken = true
font-thicken-strength = 1
adjust-cell-height = 1
font-family = "Intel One Mono"
