(defcfg
  macos-dev-names-include (
    "Keychron K2"
    "Apple Internal Keyboard / Trackpad"
  )
)

(defsrc
  esc
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  fn
  caps
  spc
  f h j k l
  u i
)

(defalias
  escctrl (tap-hold 100 100 esc lctl)
  navhold (tap-hold-release 200 200 spc (layer-toggle nav))
  fnhold (multi fn (layer-while-held fnrow))
  fshft (tap-hold-tap-keys 200 200 f lsft (
    a b c d e f g h i j k l m n o p q r s t u v w x y z
    1 2 3 4 5 6 7 8 9 0 ` - =
    ' ; , . / spc tab enter Backspace del up down left right))
  jshft (tap-hold-tap-keys 200 200 j rsft (
    a b c d e f g h i j k l m n o p q r s t u v w x y z
    1 2 3 4 5 6 7 8 9 0 ` - =
    ' ; , . / spc tab enter Backspace del up down left right))
)

(deflayer base
  @escctrl
  _ _ _ _ _ _ _ _ _ _ _ _
  @fnhold
  @escctrl
  @navhold
  @fshft _ @jshft _ _
  _ _
)

(deflayer nav
  _
  _ _ _ _ _ _ _ _ _ _ _ _
  _
  _
  _
  _ left down up right
  pgdn pgup
)

(deflayer fnrow
  _
  brdn brup mctl sls dtn dnd prev pp next mute vold volu
  _
  _
  _
  _ _ _ _ _
  _ _
)
