# YoRHa — Nier Automata UI palette (https://metakirby5.github.io/yorha/)
# Paper #d1cdb7, ink #454138, muted #bab5a1.
# Contrast vs the paper bg: base slots 0-5 and 8, 15 are >=4.5:1; cyan (6),
# white (7) and bright 9-14 sit at ~3.6-4.2:1. Bright 9-12 are lighter, more
# vivid variants of 1-4 (not darker). zed/themes/yorha.json reuses these 16.
background = d1cdb7
foreground = 3f3b33
# Build the 256-color palette (indices 16-255) from the 16 colors below, reversed
# so higher indices are darker — apps like Claude Code use indices 244/245 for
# muted text, which the default xterm ramp renders as near-invisible light gray.
palette-generate = true
palette-harmonious = true
cursor-color = 454138
selection-background = bab5a1
selection-foreground = 454138
palette = 0=#3b372f
palette = 1=#7e4226
palette = 2=#4c593a
palette = 3=#5e5020
palette = 4=#44586a
palette = 5=#6b4c55
