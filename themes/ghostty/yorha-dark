# YoRHa Dark — Nier Automata UI palette, inverted (https://metakirby5.github.io/yorha/)
# Ink #2b2823 as the page, paper #d1cdb7 as the text; the same earthy hues as
# the light theme, lifted for a dark bg. Slots 1-6 are >=5:1 and bright 9-14
# >=6.5:1 vs the bg. Bright black (8) is kept dark (~2.5:1) because apps like
# Claude Code's dark-ansi use it as a *background* under bright-white text (~4.6:1).
# zed/themes/yorha.json ("Yorha Dark") reuses these 16.
background = 2b2823
foreground = d1cdb7
# Standard (non-harmonious) ordering for a dark theme: higher indices are lighter.
palette-generate = true
palette-harmonious = false
cursor-color = d1cdb7
selection-background = 4a463c
selection-foreground = e8e4cf
